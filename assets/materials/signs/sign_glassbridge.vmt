"UnlitGeneric"
{
	"$basetexture" "signs/sign_glassbridge"
	"$surfaceprop" "Default"
	"$translucent" 1
    "Proxies"
    {
        "AnimatedTexture"
        {
        "animatedTextureVar" "$basetexture"
        "animatedTextureFrameNumVar" "$frame"
        "animatedTextureFrameRate" "0.75"
        }
    }   
}
